{
"compilerOptions": {
"module": "nodenext",
"target": "esnext",
"moduleDetection": "force",
"verbatimModuleSyntax": true,
"isolatedModules": true,
"strict": true,
"noUncheckedIndexedAccess": true,
"exactOptionalPropertyTypes": true,
"skipLibCheck": true,
"sourceMap": true,
"declaration": true,
"declarationMap": true
},
"include": ["src/**/*.ts"]
}

